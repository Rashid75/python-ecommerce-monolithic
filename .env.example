# Example settings — safe to commit, contains no real password.
#
# Make your own copy:
#     Copy-Item .env.example .env
# then replace CHANGE_ME.
#
# .env is git-ignored and is for local development only.

# --- Application ---
APP_NAME="Python Ecommerce API"

# local | staging | production
APP_ENVIRONMENT=local

# Shows detailed errors. Must be false in production.
APP_DEBUG=true

APP_API_V1_PREFIX=/api/v1

# --- Database ---
# Used by the app AND by docker-compose.yml, so each value is written once.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5433
APP_DB_USER=ecommerce
APP_DB_NAME=python-ecommerce-monolithic-db

# Required. Pick your own value:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 24 | % {[char]$_})
APP_DB_PASSWORD=CHANGE_ME

# Set to true to see every SQL statement. Must be false in production.
APP_DB_ECHO=false

# --- Authentication ---
# Required. Signs access tokens, so anyone holding it can mint a token for
# any account. Use a different value in every environment, and never commit
# a real one.
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 56 | % {[char]$_})
APP_JWT_SECRET=CHANGE_ME

# How long an access token stays valid. Keep it short: a stolen token works
# until it expires and nothing here can revoke one early.
APP_JWT_EXPIRE_MINUTES=30
